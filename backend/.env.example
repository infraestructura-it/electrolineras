# Copia este archivo como backend/.env y ajusta los valores. No se sube a git.

# Puerto de la API y del gateway OCPP (ws://<servidor>:PORT/ocpp/<numero_serie>)
PORT=3000

# Administrador. Si defines ADMIN_PASSWORD, al arrancar se crea ese admin o se le
# restablece la clave (útil para recuperar el acceso). Sin estas variables, el primer
# arranque crea admin@electrolineras.local con una clave aleatoria que sale en el log:
#   pm2 logs electrolineras --lines 50 --nostream
ADMIN_EMAIL=admin@electrolineras.local
# ADMIN_PASSWORD=

# Secreto para firmar las sesiones del panel. Vacío: se genera uno y se guarda en data/.
# JWT_SECRET=

# Carpeta de datos (JSON) mientras se conecta PostgreSQL. Por defecto: backend/data
# DATA_DIR=
